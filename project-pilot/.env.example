# Project Pilot 4.2 — Launch Revenue environment
# Copy these names into Vercel. Never commit real secret values.

# Public production site
NEXT_PUBLIC_SITE_URL=https://www.projectpiloting.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@projectpiloting.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI / Su / Project Vision
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5.6-luna
OPENAI_ASSISTANT_FAST_MODEL=gpt-5.4-nano
OPENAI_ASSISTANT_FALLBACK_MODEL=gpt-5.4-mini
PROJECT_ASSISTANT_DAILY_LIMIT=50
PROJECT_VISION_ENABLED=true
PROJECT_VISION_DAILY_LIMIT=5
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_INPUT_FIDELITY=high

# Google Maps Embed — contractor finder
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Stripe — both revenue paths use the same Stripe account and webhook.
# Use sk_test_ while testing. Replace with sk_live_ before real customer charges.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Direct homeowner revenue: one-time Full-Service Permit Concierge coordination fee.
# Test first with false, then true in Stripe test mode. Use true with live keys to collect real revenue.
PERMIT_SERVICE_PAYMENTS_ENABLED=false
PERMIT_CONCIERGE_PRICE_CENTS=9900
NEXT_PUBLIC_PERMIT_CONCIERGE_PRICE_CENTS=9900
PERMIT_CONCIERGE_MAX_CREDIT_CENTS=4000

# Contractor marketplace revenue. This can remain false until contractor onboarding is ready.
MARKETPLACE_PAYMENTS_ENABLED=false

# Email / operating inbox
RESEND_API_KEY=
MARKETPLACE_FROM_EMAIL=Project Pilot <support@projectpiloting.com>
PERMIT_CONCIERGE_EMAIL=
